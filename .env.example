# ============================================================
# GOLGI BOT — PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y completa con tus valores reales:
# ============================================================

# Clave de API de Google Gemini (Opcional, para clasificación asistida por IA)
# Obtén una clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ID del grupo de WhatsApp que contiene los materiales (ej: 120363xxxxxxxxx@g.us)
TARGET_GROUP_ID=tu_id_de_grupo@g.us

# ID de la carpeta raíz de Google Drive donde se organizarán las materias
DRIVE_FOLDER_ID=tu_id_de_carpeta_drive_aqui
